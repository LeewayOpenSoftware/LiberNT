[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\NetAdapterCx","DependOnService",0x00010000,"ndis"
HKLM,"SYSTEM\CurrentControlSet\Services\NetAdapterCx","DisplayName",0x00000000,"Network Adapter Wdf Class Extension Library"
HKLM,"SYSTEM\CurrentControlSet\Services\NetAdapterCx","ErrorControl",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\NetAdapterCx","ImagePath",0x00020000,"system32\drivers\netadaptercx.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\NetAdapterCx","Start",0x00010001,3
HKLM,"SYSTEM\CurrentControlSet\Services\NetAdapterCx","Type",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Control\Wdf\Kmdf\NetAdapterCx\Versions\2\1","Service",0x00000000,"NetAdapterCx"
