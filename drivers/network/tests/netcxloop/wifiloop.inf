; PROJECT:     LiberNT network tests
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     Installs the WiFiCx simulated link peer test adapter
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif193.001@gmail.com>

[Version]
Signature = "$Windows NT$"
Class = Net
ClassGUID = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider = %LiberNT%
DriverVer = 10/29/2026,1.0.0.0
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
wifiloop.sys = 1,,

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%LiberNT% = LiberNT,NTamd64,NTarm64

[LiberNT.NTamd64]
%WifiLoop.DeviceDesc% = WifiLoop_Device, ROOT\WIFILOOP

[LiberNT.NTarm64]
%WifiLoop.DeviceDesc% = WifiLoop_Device, ROOT\WIFILOOP

[WifiLoop_Device.NT]
AddReg = WifiLoop_AddReg
CopyFiles = WifiLoop_CopyFiles
Characteristics = 0x1
*IfType = 6
*MediaType = 0
*PhysicalMediaType = 14
*IfConnectorPresent = 0
*ConnectionType = 1
*DirectionType = 0
*AccessType = 2
*HardwareLoopback = 0

[WifiLoop_CopyFiles]
wifiloop.sys

[WifiLoop_AddReg]
HKR, Ndi, Service, 0, "WifiLoop"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "ethernet"

[WifiLoop_Device.NT.Services]
AddService = WifiLoop, 0x00000002, WifiLoop_Service

[WifiLoop_Service]
DisplayName = %WifiLoop.ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\wifiloop.sys

[WifiLoop_Device.NT.Wdf]
KmdfService = WifiLoop, WifiLoop_WdfSection

[WifiLoop_WdfSection]
KmdfLibraryVersion = 1.33

[Strings]
LiberNT = "LiberNT Project"
DiskName = "LiberNT NetAdapterCx test disk"
WifiLoop.DeviceDesc = "LiberNT WiFiCx Test Adapter"
WifiLoop.ServiceDesc = "LiberNT WiFiCx Test Adapter Service"
