HKLM,"SYSTEM\CurrentControlSet\Services\WifiCx","ErrorControl",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\WifiCx","ImagePath",0x00020000,"system32\drivers\wificx.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\WifiCx","Start",0x00010001,3
HKLM,"SYSTEM\CurrentControlSet\Services\WifiCx","Type",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Control\Wdf\Kmdf\WifiCx\Versions\1\1","Service",0x00000000,"WifiCx"
