@@ -1512,6 +1512,31 @@ public bool IsFullyTrusted {
 		public AppDomainManager DomainManager {
 			get { return (AppDomainManager)_domain_manager; }
 		}
+
+		internal static AppDomainManager InitializeDomainManager (string assemblyName, string typeName)
+		{
+			AppDomain domain = CurrentDomain;
+
+			if (domain._domain_manager != null)
+				return null;
+
+			AppDomainSetup setup = domain.SetupInformationNoCopy;
+			setup.AppDomainManagerAssembly = assemblyName;
+			setup.AppDomainManagerType = typeName;
+
+			AppDomainManager manager = (AppDomainManager) Activator.CreateInstance (assemblyName, typeName).Unwrap ();
+			domain._domain_manager = manager;
+			manager.InitializeNewDomain (setup);
+
+			if ((manager.InitializationFlags & AppDomainManagerInitializationOptions.RegisterWithHost) == 0)
+				return null;
+			return manager;
+		}
+
+		internal static string GetConfigurationFileInternal ()
+		{
+			return CurrentDomain.SetupInformationNoCopy.ConfigurationFile;
+		}
 #else
