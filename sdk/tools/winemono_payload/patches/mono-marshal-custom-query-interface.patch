+
+		public static IntPtr GetComInterfaceForObject (object o, Type T, CustomQueryInterfaceMode mode)
+		{
 #if MOBILE
 			throw new PlatformNotSupportedException ();
 #else
+			ICustomQueryInterface custom = mode == CustomQueryInterfaceMode.Allow ? o as ICustomQueryInterface : null;
+			if (custom != null && T != null) {
+				Guid iid = T.GUID;
+				IntPtr ppv;
+				switch (custom.GetInterface (ref iid, out ppv)) {
+				case CustomQueryInterfaceResult.Handled:
+					if (ppv != IntPtr.Zero)
+						return ppv;
+					throw new InvalidCastException ();
+				case CustomQueryInterfaceResult.Failed:
+					throw new InvalidCastException ();
+				}
+			}
 			IntPtr pItf = GetComInterfaceForObjectInternal (o, T);
 			AddRef (pItf);
 			return pItf;
 #endif
 		}
 
