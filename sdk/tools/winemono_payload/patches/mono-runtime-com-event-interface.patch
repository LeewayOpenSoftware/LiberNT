@@ -1308,6 +1309,25 @@
  * \returns the generated method that calls the underlying \c __ComObject
  * rather than the proxy object.
  */
+static gboolean
+cominterop_is_com_event_interface (MonoClass *klass)
+{
+	ERROR_DECL (error);
+	MonoCustomAttrInfo *cinfo;
+	gboolean result;
+
+	if (!mono_class_is_interface (klass))
+		return FALSE;
+	cinfo = mono_custom_attrs_from_class_checked (klass, error);
+	mono_error_cleanup (error);
+	if (!cinfo)
+		return FALSE;
+	result = mono_custom_attrs_has_attr (cinfo, mono_class_get_com_event_interface_attribute_class ());
+	if (!cinfo->cached)
+		mono_custom_attrs_free (cinfo);
+	return result;
+}
