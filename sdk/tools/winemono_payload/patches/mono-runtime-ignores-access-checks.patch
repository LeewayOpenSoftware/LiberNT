 static gboolean
+ignores_access_checks_to (MonoAssembly *accessing, MonoAssembly *accessed)
+{
+	ERROR_DECL (error);
+	MonoCustomAttrInfo *attrs;
+	gboolean result = FALSE;
+	int i;
+
+	if (!accessing || !accessed || accessing == accessed || !accessed->aname.name)
+		return FALSE;
+
+	attrs = mono_custom_attrs_from_assembly_checked (accessing, FALSE, error);
+	mono_error_cleanup (error);
+	if (!attrs)
+		return FALSE;
+
+	for (i = 0; i < attrs->num_attrs && !result; ++i) {
+		MonoCustomAttrEntry *attr = &attrs->attrs [i];
+		const char *data;
+		uint32_t data_length;
+
+		if (!attr->ctor || strcmp (m_class_get_name (attr->ctor->klass), "IgnoresAccessChecksToAttribute") ||
+		    strcmp (m_class_get_name_space (attr->ctor->klass), "System.Runtime.CompilerServices"))
+			continue;
+		if (attr->data_size < 4)
+			continue;
+		data = (const char*)attr->data;
+		if (data [0] != 1 || data [1] != 0 || (data [2] & 0xFF) == 0xFF)
+			continue;
+		data_length = mono_metadata_decode_value (data + 2, &data);
+		if (data + data_length > (const char*)attr->data + attr->data_size)
+			continue;
+		if (data_length == strlen (accessed->aname.name) && !g_ascii_strncasecmp (data, accessed->aname.name, data_length))
+			result = TRUE;
+	}
+	mono_custom_attrs_free (attrs);
+	return result;
+}
