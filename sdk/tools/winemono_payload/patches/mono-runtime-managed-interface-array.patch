 void
+mono_array_from_interface_lparray_impl (MonoArrayHandle array_handle, gpointer* nativeArray, MonoError *error)
+{
+#ifndef DISABLE_COM
+	if (!nativeArray || MONO_HANDLE_IS_NULL (array_handle))
+		return;
+
+	MonoArray *array = MONO_HANDLE_RAW (array_handle);
+	MonoClass * const klass_element_class = m_class_get_element_class (mono_handle_class (array_handle));
+	MonoMethod * const method = mono_get_Marshal_GetObjectForIUnknown ();
+
+	for (uintptr_t i = 0; i < array->max_length; i++) {
+		MonoObject *object = NULL;
+
+		if (nativeArray [i]) {
+			gpointer args [1] = { nativeArray + i };
+
+			object = mono_runtime_invoke_checked (method, NULL, args, error);
+			if (!is_ok (error))
+				return;
+			object = mono_object_isinst_checked (object, klass_element_class, error);
+			if (!is_ok (error))
+				return;
+		}
+		mono_array_setref_internal (array, i, object);
+	}
+#endif
+}
+
+void
+mono_array_to_interface_lparray_impl (MonoArrayHandle array_handle, gpointer* nativeArray, MonoError *error)
+{
+#ifndef DISABLE_COM
+	if (!nativeArray || MONO_HANDLE_IS_NULL (array_handle))
+		return;
+
+	MonoArray *array = MONO_HANDLE_RAW (array_handle);
+	MonoClass * const klass_element_class = m_class_get_element_class (mono_handle_class (array_handle));
+
+	for (uintptr_t i = 0; i < array->max_length; i++) {
+		gpointer itf = mono_cominterop_get_com_interface (mono_array_get_internal (array, MonoObject*, i), klass_element_class, error);
+
+		if (!is_ok (error))
+			return;
+		if (itf)
+			((MonoIUnknown *)itf)->vtable->AddRef ((MonoIUnknown *)itf);
+		nativeArray [i] = itf;
+	}
+#endif
+}
