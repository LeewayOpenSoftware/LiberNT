 #if !DISABLE_COM
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)]
+		delegate int RecordInfoData (IntPtr self, IntPtr data);
+
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)]
+		delegate int RecordInfoGuid (IntPtr self, out Guid guid);
+
+		[UnmanagedFunctionPointer (CallingConvention.StdCall)]
+		delegate int RecordInfoName (IntPtr self, out IntPtr name);
+
+		static readonly Dictionary<Guid, Type> record_types = new Dictionary<Guid, Type> ();
+
+		static T RecordInfoCall<T> (IntPtr info, int slot) where T : class
+		{
+			IntPtr vtbl = Marshal.ReadIntPtr (info);
+			return (T)(object)Marshal.GetDelegateForFunctionPointer (Marshal.ReadIntPtr (vtbl, slot * IntPtr.Size), typeof (T));
+		}
+
+		static Type FindRecordType (Guid guid, string name)
+		{
+			foreach (Assembly assembly in AppDomain.CurrentDomain.GetAssemblies ()) {
+				Type[] types;
+				try {
+					types = assembly.GetTypes ();
+				} catch (ReflectionTypeLoadException e) {
+					types = e.Types;
+				} catch {
+					continue;
+				}
+				foreach (Type type in types) {
+					if (type != null && type.IsValueType && !type.IsGenericTypeDefinition && (name == null || type.Name == name) && type.GUID == guid)
+						return type;
+				}
+			}
+			return null;
+		}
+
+		internal static Type GetRecordType (IntPtr info)
+		{
+			Guid guid;
+			IntPtr bstr;
+			string name = null;
+			Type type;
+
+			if (info == IntPtr.Zero)
+				throw new ArgumentException ("Specified OLE variant is invalid.");
+			if (RecordInfoCall<RecordInfoGuid> (info, 6) (info, out guid) < 0)
+				throw new ArgumentException ("The specified record cannot be mapped to a managed value class.");
+			lock (record_types) {
+				if (record_types.TryGetValue (guid, out type))
+					return type;
+			}
+			if (RecordInfoCall<RecordInfoName> (info, 7) (info, out bstr) >= 0 && bstr != IntPtr.Zero) {
+				name = Marshal.PtrToStringBSTR (bstr);
+				Marshal.FreeBSTR (bstr);
+			}
+			type = (name != null ? FindRecordType (guid, name) : null) ?? FindRecordType (guid, null);
+			if (type == null)
+				throw new ArgumentException ("The specified record cannot be mapped to a managed value class.");
+			lock (record_types) {
+				record_types [guid] = type;
+			}
+			return type;
+		}
+
+		static object GetRecordValue (IntPtr data, IntPtr info)
+		{
+			if (info == IntPtr.Zero)
+				throw new ArgumentException ("Specified OLE variant is invalid.");
+			if (data == IntPtr.Zero)
+				return null;
+			return Marshal.PtrToStructure (data, GetRecordType (info));
+		}
+#endif
